              "host": ["{{test_base_url}}"],
              "path": ["test", "timetable", "generate"]
            }
          }
        },
        {
          "name": "Run Scheduler Test with Mock Data",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwt_token}}"}],
